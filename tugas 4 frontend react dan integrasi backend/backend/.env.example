# Salin file ini menjadi .env lalu sesuaikan. Jangan commit .env yang berisi kredensial asli.

NODE_ENV=development
PORT=3000
# Harus sama persis dengan origin frontend (skema + host + port).
# Buka frontend lewat localhost:5173 -> isi localhost:5173 (bukan 127.0.0.1).
CORS_ORIGIN=http://localhost:5173

DB_SERVER=localhost
DB_PORT=1433
DB_USER=praktikum_user
DB_PASSWORD=ubah_password_database
DB_NAME=review_kantin
# Untuk SQL Server lokal biasanya: encrypt=false, trustServerCertificate=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Rahasia penanda tangan JWT (HS256). WAJIB diisi, minimal 32 karakter.
# Buat nilai acak:  node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=ubah_dengan_secret_acak_minimal_32_karakter
JWT_EXPIRES_IN=2h
# Nama cookie sesi (httpOnly). Token TIDAK disimpan di localStorage.
AUTH_COOKIE_NAME=kantin_session_ho3

# Biaya bcrypt. 10 cukup untuk praktikum, naikkan ke 12+ di produksi.
BCRYPT_SALT_ROUNDS=10
